      "source": [
        "n = int(input())\n",
        "res = \"\"\n",
        "while n > 0:\n",
        "    dig = n % 10\n",
        "\n",
        "    if dig != 0:\n",
        "        res = str(dig) + res\n",
        "    n = n // 10\n",
        "print(res)"
